@page
@model LoginModel
@{
    ViewData["Title"] = "Login";
}
<h1>@ViewData["Title"]</h1>

<p>Login Page</p>



<div class="container-fluid">
    <div class="row">
        <div class="col-sm-12">
            <div class="card tab2-card">
                <div class="card-body">
                    <ul class="nav nav-tabs tab-coupon" id="myTab" role="tablist">
                        <li class="nav-item">
                            <a class="nav-link active show" id="account-tab"
                               data-bs-toggle="tab" href="#account" role="tab"
                               aria-controls="account" aria-selected="true">Login</a>
                        </li>
                    </ul>

                    <div class="tab-content" id="myTabContent">
                        <div class="tab-pane fade active show" id="account" role="tabpanel">

                            <!-- FORM WRAPS EVERYTHING INCLUDING BUTTON -->
                            <form method="post">
                                @Html.AntiForgeryToken()

                                <div class="form-group row">
                                    <div class="col-xl-8 col-md-7">
                                        <input asp-for="EmployeeID" 
                                               class="form-control" 
                                               type="text" 
                                               placeholder="User Name" 
                                               required />
                                        @if (!string.IsNullOrEmpty(Model.LoginError))
                                        {
                                            <span class="text-danger">@Model.LoginError</span>
                                        }
                                    </div>

                                    <div class="col-xl-8 col-md-7 mt-3">
                                        <input asp-for="Password" 
                                               class="form-control" 
                                               type="password" 
                                               placeholder="Password" 
                                               required />
                                        @if (!string.IsNullOrEmpty(Model.PasswordError))
                                        {
                                            <span class="text-danger">@Model.PasswordError</span>
                                        }
                                    </div>
                                </div>

                                <div class="mt-3">
                                    <button type="submit" class="btn btn-primary">Login</button>
                                </div>

                            </form>
                            <!-- FORM ENDS HERE -->

                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>